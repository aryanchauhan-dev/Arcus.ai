generator client {
  provider = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  passwordHash String
  name         String?
  industry     String?
  bio          String?            
  experience   Int?
  skills       Json    @default("[]") 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions      Session[]
  assessments   Assessment[]
  coverLetters  CoverLetter[]

  @@index([email])
  @@index([industry])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  isRevoked Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

model Assessment {
  id             String  @id @default(cuid())
  userId         String
  quizScore      Float
  questions      Json                
  category       String
  improvementTip String?            

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([category])
}

model CoverLetter {
  id             String            @id @default(cuid())
  userId         String
  content        String                     
  jobDescription String?                   
  companyName    String
  jobTitle       String
  status         CoverLetterStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status])
}

model IndustryInsight {
  id       String @id @default(cuid())
  cacheKey String @unique
  industry String

  salaryRanges      Json               
  growthRate        Float
  demandLevel       DemandLevel
  topSkills         Json  @default("[]") 
  marketOutlook     MarketOutlook
  keyTrends         Json  @default("[]") 
  recommendedSkills Json  @default("[]") 

  nextUpdate DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([cacheKey])
  @@index([industry])
  @@index([nextUpdate])
}

enum DemandLevel {
  HIGH
  MEDIUM
  LOW
}

enum MarketOutlook {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum CoverLetterStatus {
  DRAFT
  FINAL
}